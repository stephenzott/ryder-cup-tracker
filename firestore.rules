rules_version = '2';

// How access control works in this app (no login screen, no passwords):
//
// 1. Every visitor is silently signed in anonymously (see auth.js). That
//    gives each browser a stable `request.auth.uid` — not an identity,
//    just a way for Firestore rules to recognize "this same device/tab
//    asked before."
// 2. For score entry, the app asks "Who are you?" and the visitor picks
//    their own name off the roster (no code). For admin actions
//    (pairings, roster changes) it's still a shared code, since those
//    are rare. Either way, the attempt is written to /unlocks/{uid} — a
//    document only that uid can ever read -- as either {level: 'score',
//    playerId} or {level: 'admin', code}.
// 3. The real admin code lives in /secrets/config, a document NO ONE can
//    read or write directly (allow read, write: if false below). Rules
//    can still privately compare against it using get() — that's a
//    trusted internal read, not a client read — so the actual code
//    value never travels back to any browser.
// 4. Every other collection checks /unlocks/{uid}'s `level` field to
//    decide what a given browser is allowed to write -- and for score-
//    level match updates, also checks that uid's `playerId` against the
//    specific match's sideA/sideB, so a player can only enter scores
//    for a match they're actually in (see myPlayerId() below).
//
// This is a light deterrent for a friends' trip, not bank-grade
// security: Firestore doesn't rate-limit writes, so someone could
// script repeated guesses at /unlocks, or just pick someone else's name
// off the roster. Good enough to stop idle strangers, typos, and
// accidentally editing the wrong match; not a defense against a
// motivated attacker.

service cloud.firestore {
  match /databases/{database}/documents {

    // Reads the current browser's unlock level ("score", "admin", or
    // null if it never unlocked / unlocked wrong). Used everywhere else
    // below to decide write access.
    function level() {
      return request.auth != null
        && exists(/databases/$(database)/documents/unlocks/$(request.auth.uid))
        ? get(/databases/$(database)/documents/unlocks/$(request.auth.uid)).data.level
        : null;
    }

    function isAdmin() {
      return level() == 'admin';
    }

    // Which roster player this browser picked on the "Who are you?"
    // screen (see auth.js) -- null if never set (e.g. an admin-only
    // browser that unlocked with the admin code instead). Used so a
    // score-level visitor can only edit a match they're actually
    // playing in, not any match in the round.
    function myPlayerId() {
      return request.auth != null
        && exists(/databases/$(database)/documents/unlocks/$(request.auth.uid))
        ? get(/databases/$(database)/documents/unlocks/$(request.auth.uid)).data.playerId
        : null;
    }

    // The real secret codes. Never directly readable or writable by any
    // client — only touched via get() inside this file, and only ever
    // set/edited by hand in the Firebase console.
    match /secrets/{doc} {
      allow read, write: if false;
    }

    // Each browser's own unlock attempt/result. A client can create or
    // overwrite ONLY its own uid's doc. 'score' has no secret to check
    // -- picking a real player ID off the roster IS the unlock, by
    // design, honor-system (see auth.js's "Who are you?" picker); the
    // real gate for score entry is the per-match playerId check below,
    // not this doc. 'admin' DOES require a code matching the real
    // secret, checked server-side via get() above so the real code is
    // never sent back to the browser.
    match /unlocks/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && (
          request.resource.data.level == 'score'
          || (request.resource.data.level == 'admin'
              && request.resource.data.code == get(/databases/$(database)/documents/secrets/config).data.adminCode)
        );

      allow delete: if false;
    }

    // Roster. Visible to anyone (it's just names/handicaps/teams), but
    // only the admin code can add, edit, or remove players.
    match /players/{playerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Round metadata (label/course/format/points available). Seeded
    // once by hand in the console — nothing in the app UI edits these,
    // so there's no write path for anyone.
    match /rounds/{roundId} {
      allow read: if true;
      allow write: if false;

      // Individual matches within a round. A score-level visitor can
      // update hole-by-hole results, but ONLY for a match they're
      // actually playing in (their picked player ID is in that match's
      // sideA or sideB) — and ONLY the `holes` field, never who's in
      // the match. Setting up or deleting a match (the pairings)
      // requires the admin code, which can edit any match.
      match /matches/{matchId} {
        allow read: if true;

        allow create, delete: if isAdmin();

        allow update: if isAdmin()
          || (level() == 'score'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['holes'])
              && (myPlayerId() in resource.data.sideA || myPlayerId() in resource.data.sideB));
      }
    }
  }
}
